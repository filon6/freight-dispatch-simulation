@startuml
' Simplified class diagram for defense.
' Every class, member and relation shown below exists in the uploaded Java source.
' Auxiliary classes, enums, record snapshots and many methods are deliberately omitted.

top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

package "engine" {
  class SimulationEngine {
    + initialize(): void
    + step(): Request
    + runToCompletion(): void
  }
}

package "event" {
  class EventCalendar {
    + schedule(event: SimulationEvent): SimulationEvent
    + popEarliest(): SimulationEvent
  }
  class SimulationEvent <<record>> {
    + time: double
    + type: EventType
  }
}

package "model" {
  class Source {
    - id: int
    - lambda: double
    + generateRequest(requestId: long, currentTime: double): Request
  }
  class Request {
    - id: long
    - sourceId: int
    - status: RequestStatus
    + markQueued(): void
    + markRejected(): void
    + markProcessing(): void
    + markCompleted(): void
  }
}

package "buffer" {
  class Buffer {
    - slots: List<Request>
    + place(request: Request): PlacementResult
    + take(requestId: long): Request
  }
}

package "dispatch" {
  class PlacementDispatcher {
    - buffer: Buffer
    + place(request: Request): PlacementResult
  }
  class SelectionDispatcher {
    - activeBatch: ProcessingBatch
    + dispatchReady(time: double): List<SimulationEvent>
  }
}

package "batch" {
  class ProcessingBatch {
    - pending: Set<Long>
    - running: Map<Long, Integer>
    + isFinished(): boolean
  }
}

package "processor" {
  class ProcessorPool {
    - processors: List<Processor>
    - nextIndex: int
    + assign(request: Request, time: double): SimulationEvent
    + complete(event: SimulationEvent): void
  }
  class Processor {
    - currentRequestId: Long
    - busyTime: double
    + isBusy(): boolean
  }
}

package "stats" {
  class StatisticsCollector {
    + recordGenerated(request: Request): void
    + recordRejected(requestId: long, at: double): void
    + recordCompleted(requestId: long, at: double): void
  }
}

SimulationEngine --> EventCalendar : calendar
SimulationEngine --> Source : sources
SimulationEngine --> Request : requests
SimulationEngine --> Buffer : buffer
SimulationEngine --> PlacementDispatcher : placement
SimulationEngine --> SelectionDispatcher : selection
SimulationEngine --> ProcessorPool : processors
SimulationEngine --> StatisticsCollector : statistics

EventCalendar o-- SimulationEvent : events
Source ..> Request : generates
Buffer o-- Request : slots
PlacementDispatcher --> Buffer : buffer
SelectionDispatcher --> Buffer : buffer
SelectionDispatcher --> ProcessorPool : processors
SelectionDispatcher --> ProcessingBatch : activeBatch
ProcessorPool o-- Processor : processors
ProcessorPool ..> SimulationEvent : creates
StatisticsCollector ..> Request : recordGenerated()

@enduml
