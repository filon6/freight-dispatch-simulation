@startuml
title Flowchart

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 9
skinparam titleFontSize 11
skinparam nodesep 1
skinparam ranksep 1
skinparam noteFontSize 8

skinparam activity {
  FontSize 10
  BackgroundColor #F7F9FC
  BorderColor #536271
  DiamondBackgroundColor #FFF6DE
  DiamondBorderColor #AD8842
  ArrowColor #657489
}

|Модель|
start
:Запустить симуляцию\nи запланировать поступления;

while (Моделирование завершено?) is (нет)
  :Обработать ближайшее событие;

  if (Поступила новая заявка?) then (да)
    |Источник|
    :Сформировать заявку;

    |Диспетчер постановки|
    :Передать заявку в буфер;

    |Буфер|
    if (Есть свободная ячейка?) then (да)
      :Занять первую свободную\nячейку (Д1ОЗ3);
    else (нет)
      :Заменить самую старую ожидающую\nзаявку новой (Д1ОО3);
    endif

    |Диспетчер постановки|
    :Принять новую заявку;
    note right
      Если была вытеснена старая заявка,
      зарегистрировать отказ и исключить
      её из ожидания активного пакета.
    end note

    |Модель|
    :При необходимости запланировать\nследующее поступление;

  else (Завершилось обслуживание)
    |Приборы|
    :Освободить прибор;

    |Модель|
    :Отметить заявку завершённой;
  endif

  |Диспетчер выбора|
  if (Есть свободный прибор?) then (да)
    if (Нет активного пакета\nили он завершён?) then (да)
      |Буфер|
      :Предоставить ожидающие заявки;

      |Диспетчер выбора|
      if (Есть ожидающие заявки?) then (да)
        :Выбрать источник по приоритету\nи сформировать фиксированный пакет (Д2Б5);
        note right
          Новые заявки не добавляются
          в уже активный пакет.
          Другой пакет не выбирается,
          пока текущий не завершён.
        end note
      endif
    endif

    while (Есть свободный прибор\nи ожидающая заявка пакета?) is (да)
      |Буфер|
      :Выдать заявку из пакета;

      |Диспетчер выбора|
      :Передать заявку на обслуживание;

      |Приборы|
      :Выбрать прибор по кольцу (Д2П2)\nи начать обслуживание;

      |Модель|
      :Запланировать завершение обслуживания;

      |Диспетчер выбора|
    endwhile (нет)
  endif

  |Модель|
  :Проверить состояние заявок\nи согласованность статистики;
endwhile (да)

:Вывести две итоговые таблицы;
stop
@enduml
