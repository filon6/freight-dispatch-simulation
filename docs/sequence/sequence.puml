@startuml
!pragma teoz true
title Sequence Diagram

hide footbox
autonumber
skinparam shadowing false
skinparam maxMessageSize 90
skinparam BoxPadding 10

actor "Пользователь" as User
boundary "Консольный интерфейс\n(ConsoleRunner)" as Runner
control "Движок моделирования\n(SimulationEngine)" as Engine
queue "Календарь событий\n(EventCalendar)" as Calendar
entity "Источник заявок\n(Source)" as Source
control "Диспетчер постановки\n(PlacementDispatcher)" as DP
collections "Буфер заявок\n(Buffer)" as Buffer
control "Диспетчер выбора\n(SelectionDispatcher)" as DV
participant "Пул приборов\n(ProcessorPool)" as Pool

== Запуск ==
User -> Runner: Запустить программу
note over Runner, Engine
  Консоль создаёт компоненты из конфигурации:
  источники, буфер, приборы и движок.
end note
Runner -> Engine: initialize()
loop Для каждого источника
  Engine -> Source: nextArrivalTime(currentTime)
  note right of Source
    ИБ — бесконечный источник.
    ИЗ1 — пуассоновский поток;
    интервалы поступления экспоненциальные.
  end note
  Source --> Engine: Время следующего поступления: double
  Engine -> Calendar: schedule(SimulationEvent.arrival(time, sourceId))
end
Engine --> Runner: Инициализация завершена
note right of Runner: ConsolePrinter.printState(...): шаг 0 (ОД2)

== Пошаговый режим ==
loop Пока модель не завершена; при каждом Enter
  User -> Runner: Enter
  Runner -> Engine: step()
  Engine -> Calendar: popEarliest()
  Calendar --> Engine: Ближайшее событие (с обновлением Clock)

  alt ARRIVAL — поступление заявки
    Engine -> Source: generateRequest(id, currentTime)
    Source --> Engine: Request
    Engine -> DP: place(request)
    DP -> Buffer: place(request)

    alt Есть свободная ячейка — Д1ОЗ3
      note over DP, Buffer
        Новая заявка занимает первую
        свободную ячейку буфера.
      end note
      Buffer --> DP: PlacementResult(slotIndex, null)
      note right of DP
        Новая заявка получает статус QUEUED.
        Вытеснения и отказа нет.
      end note
    else Буфер заполнен — Д1ОО3
      note over DP, Buffer
        Самая старая ожидающая заявка
        вытесняется; новая занимает её ячейку.
      end note
      Buffer --> DP: PlacementResult(slotIndex, evictedRequest)
      note right of DP
        Старая заявка получает статус REJECTED,
        новая — QUEUED; отказ записывается.
      end note
      DP -> DV: onRequestEvicted(evictedId)
      note right of DV
        Если вытесненная заявка ожидала
        в активном пакете, исключить её из него.
      end note
    end

    DP --> Engine: PlacementResult
    alt Лимит созданных заявок ещё не достигнут
      Engine -> Source: nextArrivalTime(currentTime)
      Source --> Engine: Время следующего поступления: double
      Engine -> Calendar: schedule(SimulationEvent.arrival(time, sourceId))
    else Создано targetRequests заявок
      Engine -> Calendar: cancelPendingArrivals()
      note over Engine, Calendar
        Новых заявок больше не будет,
        но уже принятые продолжают обслуживаться.
      end note
    end

  else SERVICE_COMPLETED — окончание обслуживания
    Engine -> Pool: complete(event)
    Pool --> Engine: Прибор освобождён
    note right of Engine: Заявка получает статус COMPLETED
    Engine -> DV: onRequestCompleted(requestId)
    note right of DV
      Отметить завершение заявки в активном пакете.
      Новый пакет возможен после завершения всего текущего.
    end note
  end

  == Выбор пакета и назначение приборов ==
  Engine -> DV: dispatchReady(currentTime)
  note over DV, Pool
    Д2Б5 — фиксированный пакет заявок одного источника.
    Приоритет: меньший номер источника выше.
    Новые заявки в сформированный пакет не добавляются.
  end note

  alt Есть свободный прибор и доступные заявки пакета
    opt Нет активного пакета или предыдущий завершён
      DV -> DV: createNextBatch()
      note right of DV
        Выбрать приоритетный источник среди ожидающих
        и зафиксировать заявки пакета.
      end note
    end
    loop Пока есть свободный прибор и заявка текущего пакета
      DV -> Buffer: take(requestId)
      Buffer --> DV: Request
      DV -> Pool: assign(request, currentTime)
      note right of Pool
        Д2П2 — выбор свободного прибора по кольцу.
        ПЗ2 — равномерное время обслуживания.
      end note
      Pool --> DV: SimulationEvent.serviceCompleted(...)
    end

  else Все приборы заняты
    note over DV, Pool
      Назначение сейчас невозможно.
      Ожидающие заявки остаются в буфере.
    end note

  else Нет заявок, доступных для назначения
    note over DV, Pool
      Буфер пуст либо активный пакет ещё обрабатывается,
      а ожидающих заявок в этом пакете нет.
      Другой пакет до завершения текущего не выбирается.
    end note
  end

  DV --> Engine: List<SimulationEvent>
  loop Для каждого нового обслуживания
    note right of Engine: Зафиксировать начало обслуживания (ОР1)
    Engine -> Calendar: schedule(completion)
  end
  Engine --> Runner: Request (обработанная на шаге заявка)
  note right of Runner: ConsolePrinter.printState(...): состояние после шага (ОД2)
end

== Автоматический режим ==
User -> Runner: a — выполнить до конца
loop Пока моделирование не завершено
  Runner -> Engine: step()
  Engine --> Runner: Request
end
note right of Runner: ConsolePrinter.printFinalTables(...): две итоговые таблицы

@enduml
