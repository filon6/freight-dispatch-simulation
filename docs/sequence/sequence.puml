@startuml
!pragma teoz true
title Sequence Diagram

hide footbox
autonumber
skinparam shadowing false
skinparam maxMessageSize 90
skinparam BoxPadding 10


actor "Пользователь" as User
boundary "ConsoleRunner" as Runner
control "SimulationEngine" as Engine
queue "EventCalendar" as Calendar
entity "Source" as Source
control "PlacementDispatcher\n(Д1ОЗ3 / Д1ОО3)" as DP
collections "Buffer" as Buffer
control "SelectionDispatcher\n(Д2Б5)" as DV
participant "ProcessorPool\n(Д2П2 / ПЗ2)" as Pool


== Запуск ==
User -> Runner: запуск
note over Runner, Engine
  ConsoleRunner создаёт компоненты из конфигурации.
  Затем вызывает Engine.initialize().
end note
Runner -> Engine: initialize()
loop для каждого источника
  
Engine -> Source: nextArrivalTime(currentTime)
Source --> Engine: nextArrivalTime (double) - подумать
Engine -> Calendar: schedule(SimulationEvent.arrival(nextArrivalTime, sourceId))

note right of Runner: ConsolePrinter.printState(...): шаг 0

== Пошаговый режим ==
loop при каждом Enter
  User -> Runner: Enter
  Runner -> Engine: step()
  Engine -> Calendar: popEarliest()
  Calendar --> Engine: событие

  alt ARRIVAL
    Engine -> Source: generateRequest(id, currentTime)
    Source --> Engine: Request
    Engine -> DP: place(request)
    DP -> Buffer: place(request)

    alt Есть свободная ячейка — Д1ОЗ3
      note over DP, Buffer
        Буфер находит первую свободную ячейку
        и размещает в ней новую заявку.
      end note
      Buffer --> DP: PlacementResult(slotIndex, null)
      note right of DP
        Новая заявка получает статус QUEUED.
        Отказов нет.
      end note
    else Буфер переполнен — Д1ОО3
      note over DP, Buffer
        Буфер выбирает самую старую ожидающую заявку
        и заменяет её новой в той же ячейке.
      end note
      Buffer --> DP: PlacementResult(slotIndex, evictedRequest)
      note right of DP
        Старая заявка получает статус REJECTED;
        вытеснение записывается в журнал.
        Новая заявка получает статус QUEUED.
      end note
      DP -> DV: onRequestEvicted(evictedId)
      note right of DV
        Исключить вытесненную заявку
        из ожидающих заявок активного пакета,
        если она в него входила.
      end note
    end

    DP --> Engine: PlacementResult
    note over Engine, Calendar
      Движок планирует следующее ARRIVAL
      или отменяет оставшиеся при достижении лимита.
    end note
  else SERVICE_COMPLETED
    Engine -> Pool: complete(event)
    Engine -> DV: onRequestCompleted(requestId)
  end

  Engine -> DV: dispatchReady(currentTime)
  note over DV, Pool
    Д2Б5 — фиксированный пакет одного источника.
    Д2П2 — назначение свободного прибора по кольцу.
  end note
  
  Engine -> DV: dispatchReady(currentTime)

  note over DV, Pool
    Д2Б5 — фиксированный пакет заявок
    одного источника с наивысшим приоритетом.

    Если активного пакета нет или он завершён,
    диспетчер формирует новый пакет.

    Новые заявки в текущий пакет не добавляются.
  end note

  alt Есть свободный прибор и ожидающая заявка пакета

    loop Пока есть свободные приборы и заявки пакета
      DV -> Buffer: take(requestId)
      Buffer --> DV: Request

      DV -> Pool: assign(request, currentTime)
      note right of Pool
        Д2П2 — кольцевой выбор свободного прибора.
        ПЗ2 — равномерное время обслуживания.
      end note
      Pool --> DV: SimulationEvent (завершение обслуживания)
    end

  else Все приборы заняты
    note over DV, Pool
      Назначение невозможно.
      Заявки продолжают ожидать в буфере.
    end note

  else Нет заявок, доступных для назначения
    note over DV, Pool
      Буфер может быть пустым либо
      текущий пакет ещё обрабатывается.

      Новый пакет нельзя сформировать,
      пока активный не завершён.
    end note
  end

  DV --> Engine: List<SimulationEvent>

  loop Для каждого назначенного обслуживания
    Engine -> Calendar: schedule(completion)
  end

  DV --> Engine: List<SimulationEvent>
  loop для каждого назначенного обслуживания
    Engine -> Calendar: schedule(completion)
  end
  Engine --> Runner: Request
  note right of Runner: ConsolePrinter.printState(...)
end

== Автоматический режим ==
User -> Runner: auto
loop пока модель не завершена
  Runner -> Engine: step()
end
note right of Runner: ConsolePrinter.printFinalTables(...): две итоговые таблицы

@enduml
